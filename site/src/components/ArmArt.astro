---
// Hero illustration: a stylised SO-101 arm, drawn in SVG with the site's tokens (no screenshot, no image file).
// Joints sway gently with CSS keyframes (disabled by prefers-reduced-motion). Each joint hub shows its motor ID, 1 to 6.
interface Props { idp?: string; animate?: boolean }
const { idp = 'arm', animate = true } = Astro.props;
---
<svg viewBox="60 120 520 390" role="img" aria-label="Illustration of a six-joint SO-101 robot arm reaching toward a small object on a table. Each joint is labelled with its motor ID, 1 to 6." focusable="false">
  <defs>
    <linearGradient id={`${idp}-floor`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color:var(--accent);stop-opacity:.14"/>
      <stop offset="1" style="stop-color:var(--accent);stop-opacity:0"/>
    </linearGradient>
  </defs>

  <!-- table -->
  <rect x="0" y="412" width="640" height="110" fill={`url(#${idp}-floor)`}/>
  <g stroke="var(--line2)" stroke-width="1" opacity=".55" fill="none">
    <path d="M0 436H640M0 466H640M0 506H640"/>
    <path d="M320 412L-60 520M320 412L40 520M320 412L180 520M320 412L320 520M320 412L460 520M320 412L600 520M320 412L700 520"/>
  </g>
  <path d="M0 412H640" stroke="var(--faint)" stroke-width="2"/>
  <ellipse cx="215" cy="414" rx="104" ry="8" fill="#000" opacity=".28"/>

  <!-- "0 at the middle" gauge around the shoulder-lift joint -->
  <path d="M148 290A74 74 0 0 1 282 290" fill="none" stroke="var(--line2)" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>
  <path d="M215 242v10" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/>
  <text x="215" y="232" text-anchor="middle" font-size="15" font-weight="800" fill="var(--accent-text)" font-family="var(--mono)">0</text>

  <!-- bowl and a small object to pick up -->
  <path d="M462 374h96c-2 24-20 38-48 38s-46-14-48-38z" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
  <ellipse cx="510" cy="374" rx="48" ry="7" fill="var(--bg2)" stroke="var(--line2)" stroke-width="2"/>
  <circle cx="378" cy="403" r="8" fill="none" stroke="var(--accent)" stroke-width="3"/>
  <circle cx="378" cy="403" r="2.5" fill="var(--accent)"/>

  <!-- base (motor 1: shoulder pan) -->
  <g id="j1" class="rig" style={animate ? undefined : 'animation:none'}>
    <rect x="128" y="394" width="174" height="18" rx="6" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
    <rect x="168" y="350" width="94" height="48" rx="12" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
    <rect x="190" y="322" width="50" height="34" rx="10" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
    <circle cx="215" cy="376" r="15" fill="var(--accent)"/>
    <text x="215" y="376" dy=".36em" text-anchor="middle" font-size="16" font-weight="800" fill="var(--accent-ink)">1</text>
  </g>

  <!-- shoulder lift (2) -> upper arm -->
  <g id="j2" class="rig" style={animate ? undefined : 'animation:none'}>
    <line x1="215" y1="322" x2="285" y2="185" stroke="var(--faint)" stroke-width="40" stroke-linecap="round"/>
    <line x1="215" y1="322" x2="285" y2="185" stroke="var(--line2)" stroke-width="35" stroke-linecap="round"/>
    <line x1="215" y1="322" x2="285" y2="185" stroke="var(--text)" stroke-width="7" stroke-linecap="round" opacity=".14"/>
    <circle cx="215" cy="322" r="23" fill="var(--accent)"/>
    <text x="215" y="322" dy=".36em" text-anchor="middle" font-size="18" font-weight="800" fill="var(--accent-ink)">2</text>

    <!-- elbow flex (3) -> forearm -->
    <g id="j3" class="rig" style={animate ? undefined : 'animation:none'}>
      <line x1="285" y1="185" x2="425" y2="250" stroke="var(--faint)" stroke-width="35" stroke-linecap="round"/>
      <line x1="285" y1="185" x2="425" y2="250" stroke="var(--line2)" stroke-width="30" stroke-linecap="round"/>
      <line x1="285" y1="185" x2="425" y2="250" stroke="var(--text)" stroke-width="6" stroke-linecap="round" opacity=".14"/>
      <circle cx="285" cy="185" r="20" fill="var(--accent)"/>
      <text x="285" y="185" dy=".36em" text-anchor="middle" font-size="17" font-weight="800" fill="var(--accent-ink)">3</text>

      <!-- wrist flex (4) -> gripper -->
      <g id="j4" class="rig" style={animate ? undefined : 'animation:none'}>
        <rect x="410" y="256" width="30" height="48" rx="10" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
        <rect x="411" y="296" width="12" height="62" rx="5" fill="var(--line2)" stroke="var(--faint)" stroke-width="2"/>
        <g id="jaw" class="rig" style={animate ? undefined : 'animation:none'}>
          <rect x="429" y="296" width="12" height="62" rx="5" fill="var(--accent)" opacity=".92"/>
        </g>
        <circle cx="425" cy="250" r="16" fill="var(--accent)"/>
        <text x="425" y="250" dy=".36em" text-anchor="middle" font-size="15" font-weight="800" fill="var(--accent-ink)">4</text>
        <circle cx="425" cy="276" r="9" fill="var(--bg)" stroke="var(--accent)" stroke-width="2"/>
        <text x="425" y="276" dy=".36em" text-anchor="middle" font-size="11" font-weight="800" fill="var(--accent-text)">5</text>
        <circle cx="435" cy="304" r="8" fill="var(--bg)" stroke="var(--accent)" stroke-width="2"/>
        <text x="435" y="304" dy=".36em" text-anchor="middle" font-size="10" font-weight="800" fill="var(--accent-text)">6</text>
      </g>
    </g>
  </g>
</svg>
