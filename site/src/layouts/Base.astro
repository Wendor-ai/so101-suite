---
import '../styles/site.css';
import themeInit from '../scripts/theme-init.js?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DESCRIPTION, NAME, REPO } from '../data/site';

interface Props {
  title?: string;           // page title; the site name is appended
  description?: string;
  image?: string;           // path to a 1200x630 image
  noindex?: boolean;
  type?: 'website' | 'article';
  bare?: boolean;           // no header/footer (demo, og)
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | null;
}
const { title, description = DESCRIPTION, image = '/og.png', noindex = false, type = 'website', bare = false, bodyClass = '', jsonLd = null } = Astro.props;
const fullTitle = title ? `${title} · ${NAME}` : `${NAME}: set up, calibrate and learn your SO-101 robot arm`;
const site = Astro.site ?? new URL('https://so101-suite.pages.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const imageAlt = 'SO-101 Suite: from unopened box to a moving robot arm.';
const ld = jsonLd ?? null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#090c12" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:site_name" content={NAME} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <script is:inline src={themeInit}></script>
  {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</head>
<body class={bodyClass}>
  {!bare && <a class="skip" href="#main">Skip to content</a>}
  {!bare && <Header />}
  {bare ? <slot /> : <main id="main" tabindex="-1"><slot /></main>}
  {!bare && <Footer />}
  <script src="../scripts/site.js"></script>
</body>
</html>
